+async def _maybe_arbitered_inference(url, text, sampling_params, image_data,
+                                     timeout_secs=None, task_id="", step=-1):
+    """OWRL_ARBITER=1: n-candidate sampling + frontier catts_vision selection
+    (openwebrl.frontier_arbiter); otherwise a plain single inference step.
+    Returns the same (response, tokens, logprobs, finish_type) tuple — the
+    WINNER's tuple, so token/logprob bookkeeping downstream stays consistent."""
+    if os.environ.get("OWRL_ARBITER") != "1":
+        return await _run_inference_step(url, text, sampling_params, image_data,
+                                         timeout_secs=timeout_secs)
+    from openwebrl import frontier_arbiter as _fa
+    n = int(os.environ.get("OWRL_ARBITER_N", 5))
+    sp = dict(sampling_params or {})
+    sp["temperature"] = float(os.environ.get("OWRL_ARBITER_TEMP", 0.7))
+    results = await asyncio.gather(
+        *[_run_inference_step(url, text, sp, image_data, timeout_secs=timeout_secs)
+          for _ in range(n)],
+        return_exceptions=True)
+    ok = [r for r in results if not isinstance(r, BaseException)]
+    if not ok:
+        raise results[0]
+    candidates = [_fa.split_think(r[0]) for r in ok]
+    current_img = image_data[-1] if image_data else ""
+    idx, reasoning, record = await _fa.select(text, current_img, candidates)
+    _fa.log_sidecar(task_id, step, candidates, idx, reasoning, record)
+    return ok[idx]
+
