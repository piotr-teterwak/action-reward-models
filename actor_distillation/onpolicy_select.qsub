#!/bin/bash -l
#$ -P ivc-ml
#$ -l gpus=1
#$ -l gpu_compute_capability=8.6
#$ -l h_rt=12:00:00
#$ -pe omp 3
#$ -j y
#$ -N onpolicy_sel
#$ -o output/onpolicy/onpolicy_select.log
# STAGE B: serve the strongest 4B arbiter (merged all-linear selector) and pick 1 of
# the 5 on-policy candidates per state. No GPT-5.5, no $. Params via -v:
#   SEL_ROOT  (dir with states.jsonl + candidates.jsonl from stage A)
#   SEL_OUT   (selections jsonl: {state_id, selected_orig_idx, ...})
#   ARBITER_DIR (merged arbiter checkpoint; default = all-linear merged)
set -uo pipefail
PROJECT_DIR=/projectnb/ivc-ml/piotrt/browser_agents/browser-environment; cd "$PROJECT_DIR"
eval "$(conda shell.bash hook)"; conda activate molmoweb
export TMPDIR=/projectnb/ivc-ml/piotrt/vllm_cache/tmp; export XDG_CACHE_HOME=/projectnb/ivc-ml/piotrt/xdg_cache
export VLLM_NO_USAGE_STATS=1 PYTHONPATH="$PROJECT_DIR:${PYTHONPATH:-}"; mkdir -p "$TMPDIR" "$XDG_CACHE_HOME"
: "${SEL_ROOT:?set SEL_ROOT}" "${SEL_OUT:?set SEL_OUT}"
ARBITER_DIR="${ARBITER_DIR:-output/prm_offline_pilot/train_full/merged_alllinear_3894}"
NAME=q4b-al; PORT=8993
module load singularity 2>/dev/null || true
singularity exec --nv -B /projectnb/ivc-ml/piotrt:/projectnb/ivc-ml/piotrt \
    --env HF_HOME=/projectnb/ivc-ml/piotrt/hf_cache --env XDG_CACHE_HOME=/projectnb/ivc-ml/piotrt/xdg_cache \
    --env VLLM_NO_USAGE_STATS=1 /projectnb/ivc-ml/piotrt/sif/vllm-0.19.1.sif \
    vllm serve "$ARBITER_DIR" --served-model-name $NAME --trust-remote-code \
    --port $PORT --max-model-len 65536 --gpu-memory-utilization 0.9 --dtype half &
VLLM_PID=$!
for i in $(seq 1 180); do curl -s http://localhost:$PORT/v1/models 2>/dev/null | grep -q "$NAME" && { echo "arbiter ready"; break; }; sleep 5; done
# arbiter prompt config = exactly how the all-linear selector was trained (no-CoT single-shot)
ARBITER_URL=http://localhost:$PORT/v1 ARBITER_MODEL=$NAME SEL_ROOT="$SEL_ROOT" \
  CATTS_VISION_PROMPT_V2=1 CATTS_VISION_COLORED=1 VISION_NO_SOM=1 VISION_ABLATE_DOM=1 VISION_ABLATE_VOTES=1 \
  NORMALIZE_COORDS=1 CLUSTER_NO_DOM=1 VISION_NO_COT=1 CATTS_VISION_MAX_TOKENS=16384 \
  SEL_OUT="$SEL_OUT" SEL_NCHUNKS="${SEL_NCHUNKS:-1}" SEL_CHUNK="${SEL_CHUNK:-0}" SEL_CONCURRENCY=24 \
  python scripts/run_4bnc_selector_offline.py
echo "[onpolicy-sel] done $(date)"
kill $VLLM_PID 2>/dev/null || true
